{
   "name": "horizonwebrtcredirsample",
   "version": "1.0.0",
   "description": "Simple App to test WebRTC Redirecion SDK.",
   "main": "main.js",
   "scripts": {
      "start": "electron-forge start",
      "test": "test",
      "package": "electron-forge package",
      "make": "electron-forge make",
      "build": "electron-builder"
   },
   "build": {
      "appId": "Horizon Sample Electron App",
      "productName": "HorizonWebRTCRedirApp",
      "win": {
         "target": [
            "nsis"
         ],
         "icon": "resource/horizon_icon.ico"
      },
      "nsis": {
         "oneClick": false,
         "installerIcon": "resource/horizon_icon.ico",
         "uninstallerIcon": "resource/horizon_icon.ico",
         "uninstallDisplayName": " Sample Electron App Uninstaller",
         "license": "resource/license.md",
         "allowToChangeInstallationDirectory": true
      },
      "extraFiles": [
         "serverInfo.json",
         {
            "from": "node_modules/regedit/vbs",
            "to": "regedit/vbs",
            "filter": [
               "**/*"
            ]
         }
      ]
   },
   "author": "Benrui She",
   "license": "ISC",
   "overrides": {
      "tar": "^7.5.22",
      "@electron/node-gyp": {
         "tar": "^7.5.22"
      },
      "@electron/rebuild": {
         "tar": "^7.5.22"
      }
   },
   "devDependencies": {
      "@electron-forge/cli": "^7.11.2",
      "@electron-forge/maker-deb": "^7.11.2",
      "@electron-forge/maker-rpm": "^7.11.2",
      "@electron-forge/maker-squirrel": "^7.11.2",
      "@electron-forge/maker-zip": "^7.11.2",
	   "electron": ">=39.8.1",
      "electron-builder": "^26.15.7"
   },
   "dependencies": {
      "electron-squirrel-startup": "^1.0.1",
      "express": "^5.2.1",
      "regedit": "^5.1.4",
      "tasklist": "^6.0.0"
   },
   "config": {
      "forge": {
         "packagerConfig": {},
         "makers": [
            {
               "name": "@electron-forge/maker-squirrel",
               "config": {
                  "name": "redirsdktestapp"
               }
            },
            {
               "name": "@electron-forge/maker-zip",
               "platforms": [
                  "darwin"
               ]
            },
            {
               "name": "@electron-forge/maker-deb",
               "config": {}
            },
            {
               "name": "@electron-forge/maker-rpm",
               "config": {}
            }
         ]
      }
   }
}
